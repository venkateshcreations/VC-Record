{
  "name": "clickrecord",
  "version": "1.0.0",
  "description": "ClickRecord – Lightweight Windows Screen Recorder",
  "main": "dist-electron/electron/main.js",
  "author": "Venkatesh Ammireddy (https://venkateshcreations.github.io/portfolio/)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron": "electron .",
    "pack": "pnpm build && pnpm build:electron && electron-builder --dir",
    "dist": "pnpm build && pnpm build:electron && electron-builder"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.clickrecord.app",
    "productName": "VC-Record",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/@ffmpeg-installer/win32-x64/ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/@ffmpeg-installer/**/*",
      "public/icon.png",
      "public/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VC-Record"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
